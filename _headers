# Global security headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# CSP for HTML (no third-party resources on this site)
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Short cache for static assets (filenames are not content-hashed, so
# `immutable` would freeze updates out of cache for the TTL).
/assets/style.css
  Cache-Control: public, max-age=300, must-revalidate

/assets/main.js
  Cache-Control: public, max-age=300, must-revalidate

/assets/logo.svg
  Cache-Control: public, max-age=300, must-revalidate

/assets/logo-mono.svg
  Cache-Control: public, max-age=300, must-revalidate

/assets/og-image.svg
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
